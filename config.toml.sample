# config.toml.sample
# Configuration sample for Pantagraph.
# Place this file as `config.toml` (in your current directory or in `<data_dir>/config.toml`).

[tag]
# Policy for duplicate names: allow, warn, or error.
same_name_policy = "allow"
# Policy for duplicate name@specifier references: allow, warn, or error.
same_qualified_ref_policy = "error"
